<?xml version="1.0" encoding="utf-8"?>
<!--
  The JVM half of the Rust Android layer. Class names are fully qualified because the namespace is
  dev.xiaoman.host while the two contract classes keep the packages bridge.rs names:
  dev.xiaoman.hands.XiaomanAccessibilityService and dev.xiaoman.app.AgentService.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The agent talks to the model endpoints Rust is configured with. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- startAlarm opens the clock's prefilled new-alarm page (AlarmClock.ACTION_SET_ALARM). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Android 11 package visibility: launcher apps (installedAppsJson and launch), https handlers
      (openUri) and the clock (startAlarm).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
    </queries>

    <application
        android:name="dev.xiaoman.app.HostApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XiaomanHost">

        <activity
            android:name="dev.xiaoman.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Keeps the process in the foreground while Rust runs a task. Same type and the same
          subtype explanation as the Kotlin app: the platform asks for one, and "an on-device agent
          that operates other apps through an accessibility service" is exactly what this is.
        -->
        <service
            android:name="dev.xiaoman.app.AgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device personal agent that operates other apps through an accessibility service while the user waits for a task to finish; the user can stop it from the notification or overlay." />
        </service>

        <!--
          Must be exported so the system can bind it; only holders of BIND_ACCESSIBILITY_SERVICE
          (the system) can. The config file declares the same capabilities as the Kotlin app.
        -->
        <service
            android:name="dev.xiaoman.hands.XiaomanAccessibilityService"
            android:exported="true"
            android:label="@string/xiaoman_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/xiaoman_accessibility" />
        </service>

        <!--
          The debug trigger of the scripted see-and-touch run (`src/smoke.rs`):
          `adb shell am broadcast -a dev.xiaoman.smoke`. Exported because the sender is the shell,
          not this app; it runs the accessibility service against the screen and returns a summary,
          and it is the only entry point that does anything without a model.
        -->
        <receiver
            android:name="dev.xiaoman.app.SmokeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="dev.xiaoman.smoke" />
            </intent-filter>
        </receiver>

        <!--
          The developer CLI's bridge (`xiaoman run|stop`). Exported because the sender is the adb
          shell, not this app; the actions are the ones the Kotlin debug manifest registers.
        -->
        <receiver
            android:name="dev.xiaoman.app.DebugReceiver"
            android:exported="true" />

        <!-- AlarmManager's PendingIntent, and the notification card's own actions. -->
        <receiver
            android:name="dev.xiaoman.app.ReminderReceiver"
            android:exported="false" />
        <receiver
            android:name="dev.xiaoman.app.NotificationActionReceiver"
            android:exported="false" />
    </application>
</manifest>
